OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-nano

# Optional alternative provider compatibility
NVIDIA_API_KEY=
NVIDIA_MODEL=
OPENAI_BASE_URL=
NVIDIA_BASE_URL=

# API/CORS
ALLOWED_ORIGINS=https://site-sage-eta-18.vercel.app,http://localhost:3000,http://localhost:3004

# Graph database
NEO4J_URI=bolt://localhost:7687
# Optional: frontend/Vercel Neo4j URI for orange_status alignment checks.
FRONTEND_NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
MEMGRAPH_URL=
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_SCHEME=bolt
MEMGRAPH_USERNAME=your_neo4j_username
MEMGRAPH_PASSWORD=your_neo4j_password
MEMGRAPH_SSL=false

# Vector store
# Use /data/chroma on Railway with a mounted persistent volume.
CHROMA_PATH=./chroma_db

# MCP identity/auth
# Local stdio MCP can use ORANGE_USER_EMAIL as the default personal memory identity.
# Remote MCP requires bearer auth unless ORANGE_MCP_ALLOW_UNAUTHENTICATED=true.
ORANGE_USER_EMAIL=
ORANGE_MCP_BEARER_TOKEN=
ORANGE_MCP_SIGNING_SECRET=
ORANGE_PUBLIC_BACKEND_URL=https://orange-api-production.up.railway.app
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional multi-user remote mapping. JSON is preferred:
# ORANGE_MCP_TOKEN_EMAILS={"token-for-harsh":"harsh@example.com","token-for-teammate":"teammate@example.com"}
ORANGE_MCP_TOKEN_EMAILS=
ORANGE_MCP_TRANSPORT=stdio
ORANGE_MCP_PATH=/mcp

# Supabase/Postgres metadata store
# Use the Supabase pooled/direct Postgres connection string here.
SUPABASE_DB_URL=
POSTGRES_DSN=

# Optional Slack bot
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-nano

# Orange website voice guide (Saarthi integration)
# Uses OPENAI_API_KEY by default. These values can be overridden per deployment.
ORANGE_VOICE_MODEL=gpt-4o-mini
ORANGE_VOICE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
ORANGE_VOICE_TTS_MODEL=gpt-4o-mini-tts
ORANGE_VOICE_TTS_VOICE=coral
ORANGE_VOICE_TTS_FORMAT=mp3
ORANGE_VOICE_ALLOWED_ORIGINS=

# Optional alternative provider compatibility
NVIDIA_API_KEY=
NVIDIA_MODEL=
OPENAI_BASE_URL=
NVIDIA_BASE_URL=

# API/CORS
ALLOWED_ORIGINS=https://site-sage-eta-18.vercel.app,http://localhost:3000,http://localhost:3004

# Supabase Free is the only durable store: relational graph + pgvector + jobs.
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use a direct or session-pooler DSN for the long-running Render backend.
POSTGRES_DSN=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
# Browser-safe publishable/anon key; used only by the Next.js Supabase client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_JWT_ALGORITHM=ES256

# MCP identity/auth. Remote MCP uses Supabase OAuth/DCR/PKCE and requires no
# user-copied token or API key. Local stdio may use these identity defaults.
ORANGE_USER_EMAIL=
ORANGE_USER_ID=
# Public HTTPS origin of the Render web service (or local API).
# On Render, RENDER_EXTERNAL_URL is used as a fallback if this is unset.
ORANGE_PUBLIC_BACKEND_URL=https://orange-api-x38s.onrender.com
# Vercel: server proxy + public MCP connect card
ORANGE_BACKEND_URL=https://orange-api-x38s.onrender.com
NEXT_PUBLIC_ORANGE_BACKEND_URL=https://orange-api-x38s.onrender.com
ORANGE_MCP_TRANSPORT=stdio
ORANGE_MCP_PATH=/mcp
# Render/API mode should use queued durable extraction. Stdio defaults inline.
ORANGE_MEMORY_WRITE_MODE=queued
# Unsafe and intended only for isolated local protocol tests.
ORANGE_MCP_ALLOW_UNAUTHENTICATED=false

# Optional Slack bot
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
ORANGE_SLACK_COMPANY=
# Optional fallback when the Slack app cannot read user email.
# Prefer adding Slack users:read.email scope instead.
ORANGE_SLACK_DEFAULT_USER_EMAIL=
